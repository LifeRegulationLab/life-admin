# Firebase web app settings for this app's own project (public client identifiers, not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Where the web app lives, for supporter links sent from the phone app.
VITE_PUBLIC_URL=
# The helper (explain, draft, call script). Leave off until docs/HELPER.md checks are done.
VITE_HELPER_ON=false
VITE_HELPER_URL=
# Read aloud in the recorded voice.
VITE_SPEECH_URL=
# Dealt With Plus (docs/SETUP.md)
VITE_PLAN_URL=
VITE_CHECKOUT_URL=
VITE_PORTAL_URL=
